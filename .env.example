# Environment Configuration

# Supabase Project URL (found in your Supabase project settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (public) key (found in Supabase project settings > API > anon public)
# This key is safe to expose in the browser — it only grants access controlled by RLS
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Your public app URL (used for generating shareable links in the UI)
VITE_APP_URL=http://localhost:5173
